 "presets": {
  "zh": {
   "desc": "中文优先, 境内四件套",
   "engines": [
    "bing",
    "sogou",
    "baidu",
    "so360"
   ]
  },
  "en": {
   "desc": "英文优先, 含 google (需代理)",
   "engines": [
    "bing",
    "google",
    "marginalia"
   ]
  },
  "direct": {
   "desc": "全部免代理需求的引擎 (配了全局代理仍走代理, 要真直连加 --no-proxy)",
   "engines": [
    "bing",
    "sogou",
    "baidu",
    "so360",
    "marginalia"
   ]
  }
 },
 "extractor": {
  "trafilatura": {
   "module": "webtool.engines.extractors:extract_trafilatura",
   "desc": "trafilatura 正文抽取 (markdown, 带元数据)"
  },
  "boilerplate": {
   "module": "webtool.engines.boilerplate:extract_boilerplate",
   "desc": "readability 算法选块 (纯标准库, 不需要 lxml)"
  },
  "readability": {
   "module": "webtool.engines.extractors:extract_readability",
   "desc": "readability-lxml + html2text 兜底"
  },
  "inscriptis": {
   "module": "webtool.engines.extractors:extract_inscriptis",
   "desc": "全文纯文本保底 (整页 dump, 不参与择优)",
   "dump": true
  }
 },
 "resolver": {
  "sogou": {
   "module": "webtool.engines.sogou:resolve_link",
   "desc": "搜狗 /link 跳转链解码",
   "match": [
    "sogou.com/link"
   ]
  },
  "baidu": {
   "module": "webtool.engines.baidu:_resolve_one",
   "desc": "百度 /link? 跳转链解码",
   "match": [
    "baidu.com/link?"
   ]
  },
  "gnews": {
   "module": "webtool.engines.google:resolve_link",
   "desc": "Google News articles 链解码还原原文",
   "match": [
    "~news\\.google\\.com.*/articles/"
   ]
  }
 },
 "filter": {
  "ad": {
   "module": "webtool.filters.adfilter:filter_ad",
   "desc": "广告条目剔除 (标题/域名/URL 特征)"
  },
  "blocklist": {
   "module": "webtool.filters.blocklist:filter_blocked",
   "desc": "低质量站点剔除 (黑名单域名, 支持用户增删)"
  }
 },
 "transformer": {},
 "interceptor": {
  "captcha": {
   "module": "webtool.net.captcha:CaptchaInterceptor",
   "priority": 10,
   "desc": "人机验证页 (百度/搜狗/Google 等) 的识别与冷却; 内置同名实现, 这里可覆盖或停用"
  }
 },
 "source": {
  "search": {
   "module": "webtool.engines.source:SearchSource",
   "desc": "搜索/站点引擎 → 数据源适配器 (get_source(\"search\", engine=\"bing\"))"
  },
  "site": {
   "module": "webtool.engines.source:SiteSource",
   "desc": "站内搜索 → 数据源适配器 (get_source(\"site\", site=\"github\"))"
  },
  "hot": {
   "module": "webtool.engines.source:HotSource",
   "desc": "榜单/热搜源 → 数据源适配器 (get_source(\"hot\", hot=\"zhihu\"))"
  },
  "feed": {
   "module": "webtool.feeds.source:FeedSource",
   "desc": "RSS/Atom 源 → 数据源适配器 (get_source(\"feed\", feed=\"<名>\"))"
  },
  "page": {
   "module": "webtool.pipeline.source:PageSource",
   "desc": "URL → 正文/文件 → 数据源适配器 (get_source(\"page\").fetch({\"url\": ...}))"
  }
 }
}
