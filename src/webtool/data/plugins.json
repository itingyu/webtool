 "engine": {
  "bing": {
   "module": "webtool.engines.bing:search",
   "desc": "Bing HTML 主通道+RSS兜底, chrome指纹, 国内 cn. 直连",
   "base": 0.9,
   "params": {
    "ops": [
     "site",
     "intitle",
     "inurl",
     "exclude"
    ],
    "enabled_by_default": true,
    "captcha_signs": [
     [
      "contains",
      "challenge-form"
     ]
    ],
    "cooldown": 30,
    "rate": 0.5
   }
  },
  "sogou": {
   "module": "webtool.engines.sogou:search",
   "desc": "搜狗: PC优先(chrome指纹)→移动端(Android指纹,直出真实URL)",
   "base": 0.75,
   "params": {
    "ops": [
     "site",
     "intitle",
     "exclude"
    ],
    "enabled_by_default": true,
    "captcha_signs": [
     [
      "contains",
      "antispider"
     ],
     [
      "title_contains",
      "验证码"
     ],
     [
      "contains",
      "seccodeimage"
     ],
     [
      "contains",
      "403 forbidden"
     ],
     [
      "len_lt",
      1300
     ]
    ],
    "cooldown": 30,
    "rate": 0.8
   }
  },
  "google": {
   "module": "webtool.engines.google:search",
   "desc": "Google: web(需代理,常IP级reCAPTCHA)→news RSS 自动降级+文章链还原",
   "base": 0.95,
   "params": {
    "ops": [
     "site",
     "intitle",
     "inurl",
     "exclude"
    ],
    "enabled_by_default": false,
    "captcha_signs": [
     [
      "contains",
      "unusual traffic"
     ],
     [
      "contains",
      "www.google.com/sorry"
     ],
     [
      "contains",
      "recaptcha"
     ]
    ],
    "cooldown": 300,
    "rate": 1.0
   }
  },
  "baidu": {
   "module": "webtool.engines.baidu:search",
   "desc": "百度网页, 多步预热(cookie+sugrec行为链), 反爬严(滑块)",
   "base": 0.8,
   "params": {
    "ops": [
     "site",
     "intitle",
     "exclude"
    ],
    "enabled_by_default": true,
    "captcha_signs": [
     [
      "title_contains",
      "百度安全验证"
     ],
     [
      "contains",
      "wappass.baidu.com"
     ],
     [
      "contains",
      "mkdjump_v2"
     ],
     [
      "len_lt",
      2000
     ]
    ],
    "cooldown": 90,
    "rate": 1.2
   }
  },
  "so360": {
   "module": "webtool.engines.so360:search",
   "desc": "360 搜索, 国内直连, 中文长尾补充",
   "params": {
    "ops": [],
    "enabled_by_default": true
   }
  },
  "marginalia": {
   "module": "webtool.engines.marginalia:search",
   "desc": "Marginalia 独立索引, 小站/老网页长尾, 免key直连, sst挑战自动解",
   "params": {
    "ops": [],
    "enabled_by_default": false
   }
  },
  "exa": {
   "module": "webtool.engines.exa:search",
   "desc": "Exa 语义搜索(MCP), 免key直连, 英文/技术长尾强; 配额按出口IP计",
   "params": {
    "ops": [],
    "enabled_by_default": false
   }
  },
  "parallel": {
   "module": "webtool.engines.parallel:search",
   "desc": "Parallel 语义搜索(MCP), 匿名免key, 每月$5额度; 返回JSON含publish_date",
   "params": {
    "ops": [],
    "enabled_by_default": false
   }
  },
  "firecrawl": {
   "module": "webtool.engines.firecrawl:search",
   "desc": "Firecrawl 搜索(MCP), keyless可用, 免费层500次/月; scrape可过JS渲染",
   "params": {
    "ops": [],
    "enabled_by_default": false
   }
  }
 },
